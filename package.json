{
  "name": "tauri-codex-workspace",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || >=22.0.0"
  },
  "scripts": {
    "audit:dependencies": "npm audit --prefix app --audit-level=high",
    "check:docs": "node --test 文档/check-docs-human.test.mjs 文档/check-docs-phases.test.mjs 文档/check-docs-references.test.mjs && node 文档/check-docs.mjs",
    "docs:check": "npm run check:docs",
    "test:docs": "node --test 文档/check-docs-human.test.mjs",
    "bootstrap": "node scripts/windows-pipeline.mjs bootstrap",
    "build": "node scripts/windows-pipeline.mjs build",
    "installer:build": "node scripts/windows-pipeline.mjs installer-build",
    "installer:verify": "node scripts/windows-pipeline.mjs installer-verify",
    "build:release": "node scripts/windows-pipeline.mjs release-build",
    "verify:release": "node scripts/windows-pipeline.mjs release-verify",
    "test:rust": "node scripts/windows-pipeline.mjs rust-test",
    "test": "npm run app:build && npm run test:rust && npm run check:docs",
    "app:build": "npm --prefix app run build",
    "app:dev": "npm --prefix app run tauri:windows -- dev",
    "app:bundle": "npm run installer:build"
  }
}
